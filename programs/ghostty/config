# ─────────────────────────────────────────
# Appearance
# ─────────────────────────────────────────
# IntelliJ IDEA New UI Dark, sampled from a GoLand window. The same palette
# drives Neovim in programs/neovim/lua/plugins/colorscheme.lua. Starship uses
# named ANSI colours, so the prompt follows this without any config of its own.
background = #191a1d
foreground = #bcbec4
selection-background = #33353a
selection-foreground = #bcbec4
cursor-color = #bcbec4

palette = 0=#2b2d30
palette = 1=#f75464
palette = 2=#6aab73
palette = 3=#cf8e6d
palette = 4=#56a8f5
palette = 5=#c77dbb
palette = 6=#2aacb8
palette = 7=#bcbec4
palette = 8=#7a7e85
palette = 9=#ff7a85
palette = 10=#7fc088
palette = 11=#e0a17f
palette = 12=#6fb8ff
palette = 13=#d68fcc
palette = 14=#4cc4d0
palette = 15=#dfe1e5

window-height = 27
window-width = 118
macos-titlebar-style = "tabs"
window-padding-x = 12
window-padding-y = 8
background-opacity = 0.95
background-blur = 20
cursor-style = block
cursor-style-blink = false
adjust-cell-height = 20%

# Font
font-size = 14
font-thicken = true
font-thicken-strength = 128
font-family = "JetBrainsMono Nerd Font Mono"

# Splits
unfocused-split-opacity = 0.55
split-divider-color = #33353a

# ─────────────────────────────────────────
# Behaviour
# ─────────────────────────────────────────
confirm-close-surface = false

# ─────────────────────────────────────────
# Keybinds — Splits
# ─────────────────────────────────────────

# Create splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down

# Close split
keybind = cmd+w=close_surface

# Navigate splits
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom

# Resize splits
keybind = cmd+ctrl+left=resize_split:left,20
keybind = cmd+ctrl+right=resize_split:right,20
keybind = cmd+ctrl+up=resize_split:up,20
keybind = cmd+ctrl+down=resize_split:down,20

# Equalize splits
keybind = cmd+ctrl+equal=equalize_splits

# ─────────────────────────────────────────
# Keybinds — Tabs
# ─────────────────────────────────────────

keybind = cmd+t=new_tab
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab
keybind = cmd+1=goto_tab:1
keybind = cmd+2=goto_tab:2
keybind = cmd+3=goto_tab:3
keybind = cmd+4=goto_tab:4
keybind = cmd+5=goto_tab:5

# ─────────────────────────────────────────
# Keybinds — Misc
# ─────────────────────────────────────────

# Zoom focused split (toggle)
keybind = cmd+shift+enter=toggle_split_zoom

# Increase / decrease font size
keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size

# Clear screen
keybind = cmd+k=clear_screen
